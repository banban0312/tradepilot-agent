# 仅供本机开发；此文件不含可用的生产凭据。
POSTGRES_DB=tradepilot
POSTGRES_USER=tradepilot
POSTGRES_PASSWORD=replace-for-local-development
DATABASE_URL=postgresql+psycopg://tradepilot:replace-for-local-development@db:5432/tradepilot
CHECKPOINT_DATABASE_URL=postgresql://tradepilot:replace-for-local-development@db:5432/tradepilot
ATTACHMENTS_ROOT=/var/lib/tradepilot/attachments

# 仅显式开启后，seed 才会创建无默认密码的示例账号。
DEMO_MODE=false
DEMO_PASSWORD=
SESSION_TTL_HOURS=12
# 本地示例通过 Vite 同源代理访问；切换本机端口时同步修改。
APP_ORIGIN=http://localhost:5173
# 仅本机 HTTP 演示关闭 Secure；HTTPS 部署必须设置为 true。
SESSION_COOKIE_SECURE=false

# 留空表示未配置。填写后仍须通过真实服务集成验证。
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
OCR_PROVIDER=
OCR_API_KEY=

WEB_PORT=5173
API_PORT=8010
POSTGRES_PORT=55432
MCP_HOST_PORT=8001
MCP_URL=http://mcp:8000/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8000
