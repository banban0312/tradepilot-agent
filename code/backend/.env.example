# 仅供本机开发；此文件不含可用的生产凭据。
POSTGRES_DB=tradepilot
POSTGRES_USER=tradepilot
POSTGRES_PASSWORD=replace-for-local-development
DATABASE_URL=postgresql+psycopg://tradepilot:replace-for-local-development@db:5432/tradepilot
CHECKPOINT_SCHEMA=tradepilot_checkpoints
ATTACHMENTS_ROOT=/var/lib/tradepilot/attachments
BUSINESS_TIMEZONE=Asia/Hong_Kong

# 仅显式开启后，seed 才会创建无默认密码的示例账号。
DEMO_MODE=false
DEMO_ALLOW_SELF_APPROVAL=false
DEMO_PASSWORD=
SESSION_TTL_HOURS=12
# 本地示例通过 Vite 同源代理访问；切换本机端口时同步修改。
APP_ORIGIN=http://localhost:5173
# 仅本机 HTTP 演示关闭 Secure；HTTPS 部署必须设置为 true。
SESSION_COOKIE_SECURE=false

# 支持 openai 与 deepseek；留空表示未配置，填写后仍须通过真实服务集成验证。
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
# 可留空以使用所选供应商默认地址；OpenAI: https://api.openai.com/v1，DeepSeek: https://api.deepseek.com。
MODEL_BASE_URL=
# 单次模型/MCP 调用超时与最多重试次数；重试次数不含首次请求。
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
# Function Calling 循环总预算。
MODEL_MAX_ROUNDS=8
MODEL_MAX_TOOL_CALLS=20
# 容器默认使用本地 Tesseract；仅更换为外部适配器时才需要对应凭据。
OCR_PROVIDER=local_tesseract
OCR_API_KEY=

WEB_PORT=5173
API_PORT=8010
POSTGRES_PORT=55432
MCP_HOST_PORT=8001
MCP_URL=http://mcp:8000/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8000
# 仅供 Worker 到 MCP 的内部短期上下文签名，至少 32 字节；不要提交真实密钥。
MCP_CONTEXT_SIGNING_KEY=
